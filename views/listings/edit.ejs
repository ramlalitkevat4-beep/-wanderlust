<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Listing</title>
</head>
<body>
    <h1>Edit Listing</h1>
    <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
        <label for="title">Title:</label>
        <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" required><br><br>

        <label for="description">Description:</label>
        <textarea id="description" name="listing[description]" required><%= listing.description %></textarea><br><br>

        <label for="price">Price:</label>
        <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" required><br><br>

        <label for="locations">Locations:</label>
        <input type="text" id="locations" name="listing[locations]" value="<%= listing.locations %>" required><br><br>

        <label for="country">Country:</label>
        <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" required><br><br>

        <button type="submit">Update Listing</button>
    </form>
    
</body>
</html>