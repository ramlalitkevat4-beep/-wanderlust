<% layout('layout/boilerplate') %>
<br> <br>
<div class="row ">
    <div class="col-8 offset-2"></div>
<form method="POST" action="/listings" novalidate class="needs-validation">
    
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input id="title" type="text" class="form-control" name="listing[title]" placeholder="Title" required>
        <div class="invalid-feedback">
      Enter a title 
    </div>
    </div>

    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" class="form-control" name="listing[description]" rows="4"></textarea>
         <div class="invalid-feedback">
      Enter a description
    </div>
        
    </div>

    <div class="mb-3">
        <label for="image" class="form-label">Image URL</label>
        <input id="image" class="form-control" type="text" name="listing[image][url]" required placeholder="Image URL">
         <div class="invalid-feedback">
      Enter a Image URL required
    </div>
         
    </div>

    <div class="row">
    <div class=" col-md-4">
        <label for="price" class="form-label">Price</label>
        <input id="price" class="form-control" type="number" name="listing[price]" placeholder="Price" required>
         <div class="invalid-feedback">
      Enter a price 
    </div>
    </div>

    <div class="mb-3 col-md-8">
        <label for="location" class="form-label">Location</label>
        <input id="location" class="form-control" type="text" name="listing[location]" placeholder="Location" required>
         <div class="invalid-feedback">
      Enter a location 
    </div>
    </div>
    </div>

    <div class="mb-3">
        <label for="country" class="form-label">Country</label>
        <input id="country" class="form-control" type="text" name="listing[country]" required placeholder="Country">
         <div class="invalid-feedback">
      Enter a country
    </div>

    </div>
    <button class="btn btn-dark add-btn">Create Listing</button>
</form>
<br> <br>
</div>
</div>