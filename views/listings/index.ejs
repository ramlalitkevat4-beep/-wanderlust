<% layout('layout/boilerplate') %>
<%=success %>
    <h3>ALL LISTINGS</h3>
    <!-- <form method="GET" action="/listings/new">
    <button>create new listing</button>
</form> -->
    <div class="row row-cols-lg-3 row-cols-md-3">
        <% for (listing of alllistings) { %>
            <a href="/listings/<%=listing._id %>" class="listing-link">
                <div class="card col listing-card row" style="width: 20rem;">
                    <img src="<%= listing.image && (listing.image.url || listing.image) %>"
                        class="card-img-top" 
                        alt="listing_image" 
                        style="height:20rem">
                    <div class="card-img-overlay">abcs</div>
                    <div class="card-body">
                        <p class="card-text">
                            <%=listing.title %> </br>
                                <% if (listing.price) { %>
                                    &#8377 <%= listing.price.toLocaleString("en-IN") %> / night
                                        <% } %>

                        </p>

                    </div>
                </div>
            </a>
            <% } %>
    </div>



    <!-- <li><a href="/listings/<%= listing._id %>"><%= listing.title %></a></li> -->